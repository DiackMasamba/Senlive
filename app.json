{
  "expo": {
    "name": "Senlive",
    "slug": "senlive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.senlive.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sn.senlive.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Senlive utilise tes photos pour ta photo de profil et la couverture de tes lives.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "senlive",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "owner": "senlive",
    "extra": {
      "eas": {
        "projectId": "8fa4511a-405f-49e4-ba82-02ed7fab0877"
      }
    }
  }
}
